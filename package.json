{
	"name": "proto-plugins",
	"version": "1.0.0",
	"description": "Collection of proto plugin configurations and generators",
	"type": "module",
	"scripts": {
		"generate": "node --experimental-strip-types ./scripts/generate-proto-plugin.ts",
		"generate-auto": "node --experimental-strip-types ./scripts/generate-proto-plugin.ts --auto",
		"generate-interactive": "node --experimental-strip-types ./scripts/generate-proto-plugin.ts",
		"generate:node": "node --experimental-strip-types ./scripts/generate-proto-plugin.ts",
		"generate:bun": "bun ./scripts/generate-proto-plugin.ts",
		"generate:deno": "deno run -A ./scripts/generate-proto-plugin.ts",
		"test-plugin": "node --experimental-strip-types ./scripts/test-proto-plugin-with-proto.ts",
		"test-plugin:node": "node --experimental-strip-types ./scripts/test-proto-plugin-with-proto.ts",
		"test-plugin:bun": "bun ./scripts/test-proto-plugin-with-proto.ts",
		"test-plugin:deno": "deno run -A ./scripts/test-proto-plugin-with-proto.ts",
		"test-workflows": "node --experimental-strip-types ./scripts/test-workflows-with-act.ts",
		"test": "npm run test:node && npm run test:bun && npm run test:deno",
		"test:node": "npx poku src/test-proto-plugin.test.ts scripts/shared-utils.property.test.ts src/test-proto-plugin.property.test.ts",
		"test:bun": "bun x poku src/test-proto-plugin.test.ts scripts/shared-utils.property.test.ts src/test-proto-plugin.property.test.ts",
		"test:deno": "deno run -A npm:poku src/test-proto-plugin.test.ts scripts/shared-utils.property.test.ts src/test-proto-plugin.property.test.ts",
		"test:property": "npm run test:property:node && npm run test:property:bun && npm run test:property:deno",
		"test:property:node": "npx poku scripts/shared-utils.property.test.ts src/test-proto-plugin.property.test.ts",
		"test:property:bun": "bun x poku scripts/shared-utils.property.test.ts src/test-proto-plugin.property.test.ts",
		"test:property:deno": "deno run -A npm:poku scripts/shared-utils.property.test.ts src/test-proto-plugin.property.test.ts",
		"test:summary": "node --experimental-strip-types ./scripts/test-summary.ts",
		"validate-workflows": "trunk check .github/workflows/",
		"format-workflows": "trunk fmt .github/workflows/",
		"lint-all": "trunk check",
		"setup-act": "./scripts/setup-act-testing.sh"
	},
	"engines": {
		"node": ">=22.6.0"
	},
	"keywords": ["proto", "plugins", "github", "releases", "typescript"],
	"repository": {
		"type": "git",
		"url": "https://github.com/continuous-quality-dev/proto-plugins.git"
	},
	"dependencies": {
		"consola": "^3.4.2"
	},
	"devDependencies": {
		"fast-check": "^4.1.1",
		"poku": "^3.0.2",
		"quibble": "^0.9.2"
	}
}
