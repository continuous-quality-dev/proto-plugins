{
	"name": "proto-plugins",
	"version": "1.0.0",
	"description": "Collection of proto plugin configurations and generators",
	"type": "module",
	"scripts": {
		"// === Core Commands ===": "",
		"generate": "node --experimental-strip-types ./src/core/generate-proto-plugin.ts",
		"generate:auto": "node --experimental-strip-types ./src/core/generate-proto-plugin.ts --auto",
		"generate:interactive": "node --experimental-strip-types ./src/core/generate-proto-plugin.ts",
		"generate:stricli": "node --experimental-strip-types ./src/core/generate-proto-plugin-stricli.ts",
		"generate:stricli:auto": "node --experimental-strip-types ./src/core/generate-proto-plugin-stricli.ts --auto",

		"// === Plugin Management ===": "",
		"plugin:select": "node --experimental-strip-types src/core/proto-plugin-selection.ts",
		"plugin:install-local": "node --experimental-strip-types src/core/proto-plugin-selection.ts --install-all-local",
		"plugin:test": "node --experimental-strip-types ./src/core/test-proto-plugin-with-proto.ts",

		"// === Cross-Runtime Generation ===": "",
		"generate:node": "node --experimental-strip-types ./src/core/generate-proto-plugin.ts",
		"generate:bun": "bun ./src/core/generate-proto-plugin.ts",
		"generate:deno": "deno run -A ./src/core/generate-proto-plugin.ts",
		"generate:stricli:node": "node --experimental-strip-types ./src/core/generate-proto-plugin-stricli.ts",
		"generate:stricli:bun": "bun ./src/core/generate-proto-plugin-stricli.ts",
		"generate:stricli:deno": "deno run -A ./src/core/generate-proto-plugin-stricli.ts",

		"// === Cross-Runtime Plugin Operations ===": "",
		"plugin:select:node": "node --experimental-strip-types src/core/proto-plugin-selection.ts",
		"plugin:select:bun": "bun src/core/proto-plugin-selection.ts",
		"plugin:select:deno": "deno run -A src/core/proto-plugin-selection.ts",
		"plugin:install-local:node": "node --experimental-strip-types src/core/proto-plugin-selection.ts --install-all-local",
		"plugin:install-local:bun": "bun src/core/proto-plugin-selection.ts --install-all-local",
		"plugin:install-local:deno": "deno run -A src/core/proto-plugin-selection.ts --install-all-local",
		"plugin:test:node": "node --experimental-strip-types ./src/core/test-proto-plugin-with-proto.ts",
		"plugin:test:bun": "bun ./src/core/test-proto-plugin-with-proto.ts",
		"plugin:test:deno": "deno run -A ./src/core/test-proto-plugin-with-proto.ts",

		"// === Workflow Testing ===": "",
		"test:workflows": "node --experimental-strip-types ./src/core/test-workflows-with-act.ts",
		"test": "pnpm run test:node && pnpm run test:bun && pnpm run test:deno",
		"test:node": "pnpm exec poku src/core/test-proto-plugin.test.ts src/utils/shared-utils.property.test.ts src/core/test-proto-plugin.property.test.ts",
		"test:bun": "bun x poku src/core/test-proto-plugin.test.ts src/utils/shared-utils.property.test.ts src/core/test-proto-plugin.property.test.ts",
		"test:deno": "deno run -A npm:poku src/core/test-proto-plugin.test.ts src/utils/shared-utils.property.test.ts src/core/test-proto-plugin.property.test.ts",
		"test:property": "pnpm run test:property:node && pnpm run test:property:bun && pnpm run test:property:deno",
		"test:property:node": "pnpm exec poku src/utils/shared-utils.property.test.ts src/core/test-proto-plugin.property.test.ts",
		"test:property:bun": "bun x poku src/utils/shared-utils.property.test.ts src/core/test-proto-plugin.property.test.ts",
		"test:property:deno": "deno run -A npm:poku src/utils/shared-utils.property.test.ts src/core/test-proto-plugin.property.test.ts",
		"test-stricli": "pnpm run test-stricli:node && pnpm run test-stricli:bun",
		"test-stricli:node": "pnpm exec poku src/core/generate-proto-plugin-stricli.test.ts",
		"test-stricli:bun": "bun x poku src/core/generate-proto-plugin-stricli.test.ts",
		"test-stricli:deno": "deno run --allow-all npm:poku src/core/generate-proto-plugin-stricli.test.ts",
		"test-stricli-property": "pnpm run test-stricli-property:node && pnpm run test-stricli-property:bun",
		"test-stricli-property:node": "pnpm exec poku src/core/generate-proto-plugin-stricli.property.test.ts",
		"test-stricli-property:bun": "bun x poku src/core/generate-proto-plugin-stricli.property.test.ts",
		"test-stricli-property:deno": "deno run --allow-all npm:poku src/core/generate-proto-plugin-stricli.property.test.ts",
		"plugin-select": "node --experimental-strip-types src/core/proto-plugin-selection.ts",
		"plugin-select:node": "node --experimental-strip-types src/core/proto-plugin-selection.ts",
		"plugin-select:bun": "bun src/core/proto-plugin-selection.ts",
		"plugin-select:deno": "deno run -A src/core/proto-plugin-selection.ts",
		"plugin-install-local": "node --experimental-strip-types src/core/proto-plugin-selection.ts --install-all-local",
		"plugin-install-local:node": "node --experimental-strip-types src/core/proto-plugin-selection.ts --install-all-local",
		"plugin-install-local:bun": "bun src/core/proto-plugin-selection.ts --install-all-local",
		"plugin-install-local:deno": "deno run -A src/core/proto-plugin-selection.ts --install-all-local",
		"test:summary": "node --experimental-strip-types ./src/utils/test-summary.ts",
		"validate-workflows": "trunk check .github/workflows/",
		"format-workflows": "trunk fmt .github/workflows/",
		"lint-all": "trunk check",
		"setup-act": "./scripts/setup-act-testing.sh",
		"danger": "danger ci",
		"danger:local": "danger local",
		"generate-diagram": "node --experimental-strip-types src/diagrams/dangerfile.ts",
		"generate-diagrams-changed": "node --experimental-strip-types src/diagrams/generate-diagrams-for-changed-files.ts",
		"generate-complexity-comparison": "node --experimental-strip-types src/analysis/generate-complexity-comparison.ts",
		"complexity-metrics": "node --experimental-strip-types src/diagrams/dangerfile.ts",
		"test-complexity-comparison": "node --experimental-strip-types src/analysis/test-complexity-comparison.test.ts"
	},
	"engines": {
		"node": ">=22.6.0"
	},
	"keywords": ["proto", "plugins", "github", "releases", "typescript"],
	"repository": {
		"type": "git",
		"url": "https://github.com/continuous-quality-dev/proto-plugins.git"
	},
	"dependencies": {
		"consola": "catalog:"
	},
	"devDependencies": {
		"@stricli/core": "catalog:",
		"@typescript-eslint/parser": "catalog:",
		"@typescript-eslint/typescript-estree": "catalog:",
		"danger": "catalog:",
		"fast-check": "catalog:",
		"poku": "catalog:",
		"quibble": "catalog:"
	}
}
