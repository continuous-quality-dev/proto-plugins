{
	"name": "just",
	"type": "cli",
	"description": "🤖 Just a command runner",
	"platform": {
		"linux": {
			"download-file": "just-v{version}-{arch}-unknown-linux-musl.tar.gz",
			"archive-prefix": "just-v{version}-{arch}-unknown-linux-musl",
			"bin-path": "bin/just"
		},
		"macos": {
			"download-file": "just-v{version}-{arch}-apple-darwin.tar.gz",
			"archive-prefix": "just-v{version}-{arch}-apple-darwin",
			"bin-path": "bin/just"
		},
		"windows": {
			"download-file": "just-v{version}-{arch}-pc-windows-msvc.zip",
			"archive-prefix": "just-v{version}-{arch}-pc-windows-msvc",
			"bin-path": "bin/just.exe"
		}
	},
	"install": {
		"download-url": "https://github.com/casey/just/releases/download/v{version}/{download_file}",
		"arch": {
			"aarch64": "arm64",
			"x86_64": "amd64"
		}
	},
	"resolve": {
		"git-url": "https://github.com/casey/just"
	}
}
