{
  "name": "vale",
  "type": "cli",
  "description": ":pencil: A markup-aware linter for prose built with speed and extensibility in mind.",
  "platform": {
    "linux": {
      "download-file": "vale_v{version}-bit.tar.gz",
      "archive-prefix": "vale_v{version}-bit",
      "bin-path": "bin/vale"
    },
    "macos": {
      "download-file": "vale_v{version}-bit.tar.gz",
      "archive-prefix": "vale_v{version}-bit",
      "bin-path": "bin/vale"
    },
    "windows": {
      "download-file": "vale_v{version}-bit.zip",
      "archive-prefix": "vale_v{version}-bit",
      "bin-path": "bin/vale.exe"
    }
  },
  "install": {
    "download-url": "https://github.com/errata-ai/vale/releases/download/v{version}/{download_file}",
    "arch": {
      "aarch64": "arm64"
    }
  },
  "resolve": {
    "git-url": "https://github.com/errata-ai/vale"
  }
}
